</svg>

<nav>
  <div class="wrap">
    <a class="logo" href="#top" aria-label="مال"><img class="logo-l" alt="مال" width="92" height="128" src="data:image/webp;base64,UklGRvAaAABXRUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd------"><img class="logo-d" alt="" width="92" height="128" src="data:image/webp;base64,UklGRiQbAABXRUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd-----"></a>
    <div class="links"><a href="#features">المميزات</a><a href="#steps">كيف يعمل</a><a href="#security">الأمان</a><a href="#pricing">الأسعار</a><a href="#faq">الأسئلة</a></div>
    <button class="tg" id="tg" type="button" aria-label="تبديل الوضع الفاتح والداكن">☾</button>
    <button class="tg" id="lg" type="button" aria-label="English">EN</button>
    <a class="btn btn-p" href="#demo">ابدأ مجاناً</a>
    <button class="tg mb" id="mb" type="button" aria-label="القائمة" aria-expanded="false">☰</button>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <div>
      <span class="tag">برنامج محاسبة سحابي</span>
      <h1>حساباتك <em>بوضوح تام</em>،<br>من أي مكان</h1>
