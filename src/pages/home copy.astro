<link rel="apple-touch-icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAALQAAAC0CAIAAACyr5FlAABbs0lEQVR42u19eZxnV1FvVZ17f79fL7Pva2aSTPaFkIQkkECCskVBQEUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd----------rWsAHREzkweiTw+EcMi4BRyvkimiUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd--">
<meta name="theme-color" content="#0f766e">
<title>مال – برنامج المحاسبة السحابي</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fff;--surface:#f6f9f9;--text:#0b1f2a;--muted:#5b6b76;--primary:#0f766e;--on-primary:#fff;
  --soft:#e6f4f1;--border:#e3eaee;--card:#fff;--inv-bg:#0b1f2a;--inv-text:#fff;--inv-muted:#a9bcc5;
  --shadow:0 24px 60px -20px rgba(15,118,110,.28);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#081318;--surface:#0d1c23;--text:#eaf2f4;--muted:#93a6b0;--primary:#2dd4bf;--on-primary:#04211f;
    --soft:#0f2b2c;--border:#1b2f38;--card:#0d1c23;--inv-bg:#12343a;--inv-text:#fff;--inv-muted:#a9c4c9;
    --shadow:0 24px 60px -20px rgba(0,0,0,.6);
  }
}
:root[data-theme="dark"]{
  --bg:#081318;--surface:#0d1c23;--text:#eaf2f4;--muted:#93a6b0;--primary:#2dd4bf;--on-primary:#04211f;
  --soft:#0f2b2c;--border:#1b2f38;--card:#0d1c23;--inv-bg:#12343a;--inv-text:#fff;--inv-muted:#a9c4c9;
  --shadow:0 24px 60px -20px rgba(0,0,0,.6);
}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 76px)}
*{box-sizing:border-box;margin:0}
body{font-family:"IBM Plex Sans Arabic",Tahoma,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.8;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%}
body{overflow-x:clip}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
section{padding:96px 0}
.alt{background:var(--surface)}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--border)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
nav .wrap{display:flex;align-items:center;height:68px;gap:28px}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:24px}
.logo b{width:36px;height:36px;border-radius:10px;background:var(--primary);color:var(--on-primary);display:grid;place-items:center}
.logo img{height:52px;width:auto;display:block}
.logo-d{display:none!important}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .logo-l{display:none}:root:not([data-theme="light"]) .logo-d{display:block!important}}
:root[data-theme="dark"] .logo-l{display:none}
:root[data-theme="dark"] .logo-d{display:block!important}
:root[data-theme="light"] .logo-l{display:block}
:root[data-theme="light"] .logo-d{display:none!important}
.links{display:flex;gap:26px;margin-inline-start:auto;color:var(--muted);font-size:15px}
.links a:hover{color:var(--text)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 26px;border-radius:12px;font:600 15px inherit;font-family:inherit;border:1px solid transparent;cursor:pointer;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn-p{background:var(--primary);color:var(--on-primary);box-shadow:0 10px 24px -10px var(--primary)}
.btn-o{border-color:var(--border);color:var(--text);background:transparent}
nav .btn{padding:10px 20px}
.tg{width:42px;height:42px;border-radius:12px;border:1px solid var(--border);background:transparent;color:var(--text);font-size:19px;cursor:pointer;display:grid;place-items:center;transition:background .2s}
.tg:hover{background:var(--soft)}
.mb{display:none}

/* hero */
.hero{padding:72px 0 24px;background:radial-gradient(900px 400px at 85% -10%,var(--soft),transparent 70%)}
.hero .wrap{text-align:center}
.tag{display:inline-block;background:var(--soft);color:var(--primary);padding:5px 16px;border-radius:99px;font-size:14px;font-weight:600}
h1{font-size:clamp(34px,5vw,56px);line-height:1.25;font-weight:700;margin:20px 0;letter-spacing:-.5px}
h1 em{font-style:normal;color:var(--primary)}
.lead{font-size:19px;color:var(--muted);max-width:640px;margin-inline:auto}
.cta{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin:32px 0 14px}
.note{font-size:14px;color:var(--muted)}
.shot{background:var(--card);border:1px solid var(--border);border-radius:18px;overflow:hidden;box-shadow:var(--shadow)}
.shot .bar{display:flex;gap:6px;padding:11px 14px;background:var(--surface);border-bottom:1px solid var(--border)}
.shot .bar i{width:10px;height:10px;border-radius:50%;background:var(--border)}
.shot img{display:block;width:100%;height:auto}
#preview{padding-top:48px}
.row{display:grid;grid-template-columns:1.3fr 1fr;gap:56px;align-items:center;margin-top:80px}
.row.b{grid-template-columns:1fr 1.3fr}
.title+.row{margin-top:0}
.row h3{font-size:28px;font-weight:700;line-height:1.4;margin:14px 0 10px}
.row p{color:var(--muted);font-size:17px}
@media (max-width:900px){.row,.row.b{grid-template-columns:minmax(0,1fr);gap:24px;margin-top:56px}.row .shot{order:-1}}
details{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:0 22px;margin-bottom:12px}
summary{cursor:pointer;list-style:none;padding:20px 0;font-weight:600;font-size:17px;display:flex;justify-content:space-between;gap:16px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:26px;line-height:1;color:var(--primary)}
details[open] summary::after{content:"−"}
details p{color:var(--muted);padding:0 0 20px}
.faq{max-width:780px;margin:0 auto}
.demo>*{min-width:0}
.demo{background:var(--primary);color:var(--on-primary);border-radius:32px;padding:56px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.demo h2{font-size:clamp(28px,4vw,40px);font-weight:700;line-height:1.35}
.demo p{opacity:.88;font-size:18px;margin-top:12px}
.demo form{min-width:0;background:var(--card);color:var(--text);border-radius:22px;padding:28px;display:grid;gap:14px}
.demo label{font-size:14px;font-weight:600;display:grid;gap:6px}
.demo input,.demo select,.demo textarea{width:100%;min-width:0;max-width:100%;font:inherit;font-weight:400;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text)}
.demo textarea{resize:vertical}
.req{color:#dc2626;font-style:normal;margin-inline-start:2px}
.demo input:focus,.demo select:focus,.demo textarea:focus{outline:2px solid var(--primary);outline-offset:1px}
footer{background:var(--surface);border-top:1px solid var(--border);padding:64px 0 0;color:var(--muted);font-size:15px}
.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:48px}
footer .logo img{height:46px}
footer .brand p{margin:14px 0 20px;max-width:340px}
footer h4{color:var(--text);font-size:16px;font-weight:600;margin-bottom:12px}
footer .fcol a{display:block;padding:5px 0;transition:color .2s}
footer .fcol a:hover{color:var(--primary)}
.fbar{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-top:1px solid var(--border);margin-top:48px;padding:22px 0;font-size:14px}
.fbar a:hover{color:var(--primary)}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btns .btn{padding:13px 10px;white-space:nowrap}
.btns svg{width:18px;height:18px}
.demo [hidden]{display:none}
@media (max-width:420px){.btns{grid-template-columns:1fr}}
.fab{position:fixed;left:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:25;width:58px;height:58px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;box-shadow:0 12px 28px -8px rgba(37,211,102,.6);transition:transform .2s}
.fab:hover{transform:scale(1.08)}
.fab svg.i{width:32px;height:32px;fill:currentColor;stroke:none}
.mock{background:var(--card);border:1px solid var(--border);border-radius:24px;padding:24px;box-shadow:var(--shadow)}
.mock-h{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:18px}
.dots{display:flex;gap:6px}.dots i{width:10px;height:10px;border-radius:50%;background:var(--border)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{background:var(--surface);border-radius:14px;padding:14px 16px}
.stat small{color:var(--muted);font-size:13px}.stat strong{display:block;font-size:24px;font-weight:700}
.stat span{color:var(--primary);font-size:13px;font-weight:600}
.bars{display:flex;align-items:flex-end;gap:10px;height:140px;margin-top:20px}
.bars i{flex:1;border-radius:8px;background:var(--soft);height:var(--h);transform-origin:bottom;animation:grow 1.1s cubic-bezier(.2,.7,.2,1) both}
.bars i:nth-child(6){background:var(--primary)}
@keyframes grow{from{transform:scaleY(.05)}}

/* titles */
.title{text-align:center;max-width:620px;margin:0 auto 56px}
.title h2{font-size:clamp(28px,4vw,40px);font-weight:700;line-height:1.35}
.title p{color:var(--muted);font-size:18px;margin-top:12px}

/* features */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:28px;transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.ic{width:48px;height:48px;border-radius:14px;background:var(--soft);color:var(--primary);display:grid;place-items:center;margin-bottom:18px}
.card h3{font-size:19px;font-weight:600;margin-bottom:6px}
.card p{color:var(--muted);font-size:15.5px}

/* steps */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;text-align:center}
.num{width:56px;height:56px;border-radius:50%;background:var(--primary);color:var(--on-primary);display:grid;place-items:center;font-size:22px;font-weight:700;margin:0 auto 18px}
.steps h3{font-size:20px;font-weight:600}.steps p{color:var(--muted);max-width:280px;margin:6px auto 0}

/* pricing */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.plan{background:var(--card);border:1px solid var(--border);border-radius:24px;padding:32px;display:flex;flex-direction:column}
.plan.hot{background:var(--inv-bg);color:var(--inv-text);border-color:var(--inv-bg);transform:scale(1.03)}
.plan h3{font-size:20px;font-weight:600}
.price{font-size:46px;font-weight:700;margin:10px 0 18px;line-height:1.2}
.price small{font-size:14px;font-weight:400;color:var(--muted)}
.hot .price small{color:var(--inv-muted)}
.plan ul{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:10px;flex:1}
.plan li{display:flex;gap:10px;align-items:center;font-size:15.5px}
.plan li svg{width:20px;height:20px;color:var(--primary);flex:none}
.plan .btn{width:100%}

/* final */
.final{background:var(--primary);color:var(--on-primary);border-radius:32px;padding:72px 24px;text-align:center}
.final h2{font-size:clamp(28px,4vw,40px);font-weight:700}
.final p{opacity:.85;font-size:18px;margin:10px 0 28px}
.final .btn{background:var(--bg);color:var(--primary)}

/* reveal */
.rv{opacity:0;transform:translateY(22px);transition:opacity .7s,transform .7s}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}.bars i{animation:none}html{scroll-behavior:auto}}

@media (max-width:900px){
  section{padding:64px 0}
  nav .wrap{gap:10px}
  .links{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;gap:0;margin:0;padding:8px 24px 16px;background:var(--bg);border-bottom:1px solid var(--border);box-shadow:0 24px 32px -24px rgba(0,0,0,.3)}
  nav.open .links{display:flex}
  .links a{padding:13px 0;color:var(--text);font-size:16px;border-bottom:1px solid var(--border)}
  .links a:last-child{border-bottom:0}
  .tg{margin-inline-start:auto}
  .mb{display:grid}
  .demo{grid-template-columns:minmax(0,1fr);padding:32px 18px;gap:24px;border-radius:26px}
  .demo form{padding:20px 16px}
  .fgrid{grid-template-columns:1.3fr 1fr 1fr;gap:16px}
  .grid,.steps,.plans{grid-template-columns:minmax(0,1fr)}
  .plans{max-width:480px;margin-inline:auto}
  .plan.hot{transform:none}
}
@media (min-width:600px) and (max-width:900px){
  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .steps{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .fgrid{grid-template-columns:1.4fr 1fr 1fr}
  .fgrid .brand{grid-column:auto}
}
@media (max-width:480px){
  .wrap{padding:0 16px}
  .title{margin-bottom:36px}
  .hero{padding-top:44px}
  .lead{font-size:17px}
  .cta{flex-direction:column}
  .cta .btn{width:100%}
  .card{padding:22px}
  .plan{padding:24px}
  summary{font-size:16px}
  footer{font-size:14px;padding-top:44px}
  footer .logo img{height:38px}
  footer .brand p{font-size:13px;line-height:1.7;margin:10px 0 14px}
  footer .brand .btn{padding:9px 12px;font-size:13px}
  footer h4{font-size:15px;margin-bottom:8px}
  footer .fcol a{overflow-wrap:anywhere}
}
#lg{margin-inline-start:0;font-size:14px;font-weight:700;font-family:inherit;letter-spacing:.3px}
html[dir="ltr"] .fab{left:auto;right:20px}
.demo .fld{font-size:14px;font-weight:600;display:grid;gap:6px;min-width:0}
.pf{position:relative;display:flex;gap:8px;min-width:0}
.pf .cc{display:flex;align-items:center;gap:6px;flex:none;padding:0 10px;border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);font:inherit;font-weight:500;cursor:pointer;white-space:nowrap}
.pf .cc:focus-visible{outline:2px solid var(--primary);outline-offset:1px}
.pf .cc svg{width:14px;height:14px;opacity:.6}
.pf input#phn{flex:1;min-width:0;width:auto;text-align:left}
.cl{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:40;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);padding:10px;font-weight:400}
.cl .cs{margin-bottom:8px}
.cl ul{list-style:none;margin:0;padding:0;max-height:240px;overflow-y:auto;position:relative}
.cl li{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:10px;cursor:pointer;font-size:15px}
.cl li:hover,.cl li[aria-selected="true"]{background:var(--soft)}
.cl .cn{flex:1;min-width:0}
.cl .cd{color:var(--muted);direction:ltr;font-size:14px}
.cl .ce{cursor:default;color:var(--muted)}
.fe{font-size:20px;line-height:1}
.fi{width:24px;height:18px;border-radius:3px;object-fit:cover;display:block;flex:none}
.fc{font-size:11px;font-weight:700;color:var(--muted);min-width:24px;text-align:center}
</style>
</head>
<body>
